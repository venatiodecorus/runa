{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "gen:vectors": "vitest run --config vitest.scripts.config.ts",
    "seed": "vite-node scripts/seed.ts",
    "m7-exit": "VITE_API_BASE=http://127.0.0.1:8791 vite-node scripts/m7-exit.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@runa/core": "*",
    "@scure/base": "^1.2.4",
    "@scure/bip39": "^1.5.4",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  }
}
